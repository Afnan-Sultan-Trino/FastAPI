@prefix : <http://www.semanticweb.org/as/ontologies/2026/6/Food_Nutrition_Graph/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <http://www.semanticweb.org/as/ontologies/2026/6/Food_Nutrition_Graph/> .

<http://www.semanticweb.org/as/ontologies/2026/6/Food_Nutrition_Graph> rdf:type owl:Ontology ;
    rdfs:comment "Bangladeshi Food Ontology for Nutritional Deficiency Detection and Personalized Local Food Recommendation. NOTE: Food nutrient values below are close-range estimates compiled from standard food-composition references (USDA FoodData Central / commonly cited South Asian food composition sources) because exact INFS (Institute of Nutrition and Food Science, Dhaka University) table values were not available at generation time. RDA values are based on WHO/NIH adult reference intakes, with ICMR-style South Asian bioavailability notes flagged separately for Iron and Zinc. ALL numeric values in this file should be cross-checked against the actual INFS food composition table and a recognized RDA table (WHO/ICMR/BSTI) before being used in publication or clinical claims."@en .


#################################################################
#    Object Properties
#################################################################

###  causesSymptom
:causesSymptom rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf owl:topObjectProperty ;
               rdfs:domain :Nutrient ;
               rdfs:range :Symptom ;
               rdfs:comment "Links a nutrient to a symptom that its deficiency can cause."@en .


###  enhancesAbsorption
:enhancesAbsorption rdf:type owl:ObjectProperty ;
                    rdfs:subPropertyOf owl:topObjectProperty ;
                    rdfs:domain :Food ;
                    rdfs:range :Nutrient ;
                    rdfs:comment "Links a food to a nutrient whose absorption it enhances when eaten together (e.g. Vitamin C rich foods enhancing iron absorption)."@en .


###  hasNutrient
:hasNutrient rdf:type owl:ObjectProperty ;
             rdfs:subPropertyOf owl:topObjectProperty ;
             rdfs:domain :Food ;
             rdfs:range :Nutrient ;
             rdfs:comment "Links a food to a nutrient it meaningfully contains."@en .


###  treatedBy
:treatedBy rdf:type owl:ObjectProperty ;
           rdfs:subPropertyOf owl:topObjectProperty ;
           rdfs:domain :Nutrient ;
           rdfs:range :Food ;
           rdfs:comment "Links a nutrient (deficiency) to a food that is a good source to treat it."@en .


#################################################################
#    Data properties
#################################################################

###  hasCalcium_mg_per_100g
:hasCalcium_mg_per_100g rdf:type owl:DatatypeProperty ;
                        rdfs:subPropertyOf owl:topDataProperty ;
                        rdfs:domain :Food ;
                        rdfs:range xsd:float .


###  hasCarbohydrate_g_per_100g
:hasCarbohydrate_g_per_100g rdf:type owl:DatatypeProperty ;
                            rdfs:subPropertyOf owl:topDataProperty ;
                            rdfs:domain :Food ;
                            rdfs:range xsd:float .


###  hasFatContent_g_per_100g
:hasFatContent_g_per_100g rdf:type owl:DatatypeProperty ;
                          rdfs:subPropertyOf owl:topDataProperty ;
                          rdfs:domain :Food ;
                          rdfs:range xsd:float .


###  hasIronContent_mg_per_100g
:hasIronContent_mg_per_100g rdf:type owl:DatatypeProperty ;
                            rdfs:subPropertyOf owl:topDataProperty ;
                            rdfs:domain :Food ;
                            rdfs:range xsd:float .


###  hasProteinContent_g_per_100g
:hasProteinContent_g_per_100g rdf:type owl:DatatypeProperty ;
                              rdfs:subPropertyOf owl:topDataProperty ;
                              rdfs:domain :Food ;
                              rdfs:range xsd:float .


###  hasRDA_female_daily
:hasRDA_female_daily rdf:type owl:DatatypeProperty ;
                     rdfs:subPropertyOf owl:topDataProperty ;
                     rdfs:domain :Nutrient ;
                     rdfs:range xsd:float .


###  hasRDA_male_daily
:hasRDA_male_daily rdf:type owl:DatatypeProperty ;
                   rdfs:subPropertyOf owl:topDataProperty ;
                   rdfs:domain :Nutrient ;
                   rdfs:range xsd:float .


###  hasServingSize_g
:hasServingSize_g rdf:type owl:DatatypeProperty ;
                  rdfs:subPropertyOf owl:topDataProperty ;
                  rdfs:domain :Food ;
                  rdfs:range xsd:float .


###  hasVitaminA_mcg_per_100g
:hasVitaminA_mcg_per_100g rdf:type owl:DatatypeProperty ;
                          rdfs:subPropertyOf owl:topDataProperty ;
                          rdfs:domain :Food ;
                          rdfs:range xsd:float .


###  hasVitaminC_mg_per_100g
:hasVitaminC_mg_per_100g rdf:type owl:DatatypeProperty ;
                         rdfs:subPropertyOf owl:topDataProperty ;
                         rdfs:domain :Food ;
                         rdfs:range xsd:float .


###  hasVitaminD_mcg_per_100g
:hasVitaminD_mcg_per_100g rdf:type owl:DatatypeProperty ;
                          rdfs:subPropertyOf owl:topDataProperty ;
                          rdfs:domain :Food ;
                          rdfs:range xsd:float .


###  hasZincContent_mg_per_100g
:hasZincContent_mg_per_100g rdf:type owl:DatatypeProperty ;
                            rdfs:subPropertyOf owl:topDataProperty ;
                            rdfs:domain :Food ;
                            rdfs:range xsd:float .


#################################################################
#    Classes
#################################################################

###  Food
:Food rdf:type owl:Class .

###  Grain  (also covers roots/tubers/starchy staples for simplicity)
:Grain rdf:type owl:Class ;
       rdfs:subClassOf :Food .

###  Legume  (also covers nuts/seeds for simplicity)
:Legume rdf:type owl:Class ;
        rdfs:subClassOf :Food .

###  Vegetable
:Vegetable rdf:type owl:Class ;
           rdfs:subClassOf :Food .

###  GreenLeafy
:GreenLeafy rdf:type owl:Class ;
            rdfs:subClassOf :Vegetable .

###  OtherVegetable
:OtherVegetable rdf:type owl:Class ;
                rdfs:subClassOf :Vegetable .

###  Fruit
:Fruit rdf:type owl:Class ;
       rdfs:subClassOf :Food .

###  CitrusFruit
:CitrusFruit rdf:type owl:Class ;
             rdfs:subClassOf :Fruit .

###  OtherFruit
:OtherFruit rdf:type owl:Class ;
            rdfs:subClassOf :Fruit .

###  Meat
:Meat rdf:type owl:Class ;
      rdfs:subClassOf :Food .

###  Fish
:Fish rdf:type owl:Class ;
      rdfs:subClassOf :Food .

###  Egg
:Egg rdf:type owl:Class ;
     rdfs:subClassOf :Food .

###  Dairy
:Dairy rdf:type owl:Class ;
       rdfs:subClassOf :Food .

###  Oil
:Oil rdf:type owl:Class ;
     rdfs:subClassOf :Food .

###  JunkFood
:JunkFood rdf:type owl:Class ;
          rdfs:subClassOf :Food ;
          rdfs:comment "Lifestyle-tracking category, excluded from WHO DDS scoring."@en .

###  Beverage  (tea/coffee)
:Beverage rdf:type owl:Class ;
          rdfs:subClassOf :Food ;
          rdfs:comment "Lifestyle-tracking category, excluded from WHO DDS scoring."@en .

###  Nutrient
:Nutrient rdf:type owl:Class .

###  Macronutrient
:Macronutrient rdf:type owl:Class ;
               rdfs:subClassOf :Nutrient .

###  Micronutrient
:Micronutrient rdf:type owl:Class ;
               rdfs:subClassOf :Nutrient .

###  Symptom
:Symptom rdf:type owl:Class .


#################################################################
#    Individuals — Nutrients (Macronutrient / Micronutrient)
#################################################################

###  Protein
:Protein rdf:type owl:NamedIndividual , :Macronutrient ;
         :hasRDA_male_daily "56.0"^^xsd:float ;
         :hasRDA_female_daily "46.0"^^xsd:float ;
         :treatedBy :MurgirMangsho , :GorurMangsho , :Dim , :MasoorDal .

###  Carbohydrate
:Carbohydrate rdf:type owl:NamedIndividual , :Macronutrient ;
              :hasRDA_male_daily "130.0"^^xsd:float ;
              :hasRDA_female_daily "130.0"^^xsd:float .

###  Fat
:Fat rdf:type owl:NamedIndividual , :Macronutrient ;
     rdfs:comment "No single-value RDA asserted; total fat intake is usually expressed as a % of calories (AMDR), not a fixed gram target."@en .

###  Iron
:Iron rdf:type owl:NamedIndividual , :Micronutrient ;
      :hasRDA_male_daily "19.0"^^xsd:float ;
      :hasRDA_female_daily "29.0"^^xsd:float ;
      :causesSymptom :Fatigue , :HairLoss , :PoorConcentration ;
      :treatedBy :LalShak , :Ilish , :Dim , :MasoorDal ;
      rdfs:comment "RDA uses ICMR-style South Asian value (higher, adjusts for lower bioavailability of iron from phytate-rich, plant-dominant diets). WHO/US value is lower (M 8mg / F 18mg) — verify which reference your INFS source uses."@en .

###  Calcium
:Calcium rdf:type owl:NamedIndividual , :Micronutrient ;
         :hasRDA_male_daily "1000.0"^^xsd:float ;
         :hasRDA_female_daily "1000.0"^^xsd:float ;
         :causesSymptom :BoneJointPain ;
         :treatedBy :Dudh , :Doi , :LalShak .

###  Zinc
:Zinc rdf:type owl:NamedIndividual , :Micronutrient ;
      :hasRDA_male_daily "11.0"^^xsd:float ;
      :hasRDA_female_daily "8.0"^^xsd:float ;
      :causesSymptom :HairLoss , :FrequentIllness ;
      :treatedBy :GorurMangsho , :Chola ;
      rdfs:comment "WHO/US value shown; ICMR South Asian reference (low-bioavailability diet) is notably higher (~M 17mg / F 13mg) — verify against your chosen RDA table."@en .

###  VitaminA
:VitaminA rdf:type owl:NamedIndividual , :Micronutrient ;
          :hasRDA_male_daily "900.0"^^xsd:float ;
          :hasRDA_female_daily "700.0"^^xsd:float ;
          :causesSymptom :NightBlindness , :DryFlakySkin ;
          :treatedBy :LalShak , :Gajar , :MishtiKumra .

###  VitaminC
:VitaminC rdf:type owl:NamedIndividual , :Micronutrient ;
          :hasRDA_male_daily "90.0"^^xsd:float ;
          :hasRDA_female_daily "75.0"^^xsd:float ;
          :causesSymptom :GumBleeding , :FrequentIllness ;
          :treatedBy :Amloki , :Kamalalebu , :Pepe .

###  VitaminD
:VitaminD rdf:type owl:NamedIndividual , :Micronutrient ;
          :hasRDA_male_daily "15.0"^^xsd:float ;
          :hasRDA_female_daily "15.0"^^xsd:float ;
          :causesSymptom :BoneJointPain , :DryFlakySkin ;
          :treatedBy :Ilish , :Dim , :Dudh .


#################################################################
#    Individuals — Symptoms
#################################################################

:Fatigue           rdf:type owl:NamedIndividual , :Symptom .
:HairLoss          rdf:type owl:NamedIndividual , :Symptom .
:GumBleeding       rdf:type owl:NamedIndividual , :Symptom .
:NightBlindness    rdf:type owl:NamedIndividual , :Symptom .
:DryFlakySkin      rdf:type owl:NamedIndividual , :Symptom .
:BoneJointPain     rdf:type owl:NamedIndividual , :Symptom .
:FrequentIllness   rdf:type owl:NamedIndividual , :Symptom .
:PoorConcentration rdf:type owl:NamedIndividual , :Symptom .


