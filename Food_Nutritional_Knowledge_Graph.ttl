@prefix : <http://www.semanticweb.org/as/ontologies/2026/6/Food_Nutrition_Graph/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <http://www.semanticweb.org/as/ontologies/2026/6/Food_Nutrition_Graph/> .

<http://www.semanticweb.org/as/ontologies/2026/6/Food_Nutrition_Graph> rdf:type owl:Ontology ;
                                                                        rdfs:comment "Bangladeshi Food Ontology for Nutritional Deficiency Detection and Personalized Local Food Recommendation. NOTE: Food nutrient values below are close-range estimates compiled from standard food-composition references (USDA FoodData Central / commonly cited South Asian food composition sources) because exact INFS (Institute of Nutrition and Food Science, Dhaka University) table values were not available at generation time. RDA values are based on WHO/NIH adult reference intakes, with ICMR-style South Asian bioavailability notes flagged separately for Iron and Zinc. ALL numeric values in this file should be cross-checked against the actual INFS food composition table and a recognized RDA table (WHO/ICMR/BSTI) before being used in publication or clinical claims."@en .

#################################################################
#    Object Properties
#################################################################

###  http://www.semanticweb.org/as/ontologies/2026/6/Food_Nutrition_Graph/causesSymptom
:causesSymptom rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf owl:topObjectProperty ;
               rdfs:domain :Nutrient ;
               rdfs:range :Symptom ;
               rdfs:comment "Links a nutrient to a symptom that its deficiency can cause."@en .


###  http://www.semanticweb.org/as/ontologies/2026/6/Food_Nutrition_Graph/enhancesAbsorption
:enhancesAbsorption rdf:type owl:ObjectProperty ;
                    rdfs:subPropertyOf owl:topObjectProperty ;
                    rdfs:domain :Food ;
                    rdfs:range :Nutrient ;
                    rdfs:comment "Links a food to a nutrient whose absorption it enhances when eaten together (e.g. Vitamin C rich foods enhancing iron absorption)."@en .


###  http://www.semanticweb.org/as/ontologies/2026/6/Food_Nutrition_Graph/hasNutrient
:hasNutrient rdf:type owl:ObjectProperty ;
             rdfs:subPropertyOf owl:topObjectProperty ;
             rdfs:domain :Food ;
             rdfs:range :Nutrient ;
             rdfs:comment "Links a food to a nutrient it meaningfully contains."@en .


###  http://www.semanticweb.org/as/ontologies/2026/6/Food_Nutrition_Graph/helpsWithSymptom
:helpsWithSymptom rdf:type owl:ObjectProperty ;
                  rdfs:domain :Food ;
                  rdfs:range :Symptom ;
                  owl:propertyChainAxiom ( :isGoodSourceFor
                                           :causesSymptom
                                         ) .


###  http://www.semanticweb.org/as/ontologies/2026/6/Food_Nutrition_Graph/isGoodSourceFor
:isGoodSourceFor rdf:type owl:ObjectProperty ;
                 owl:inverseOf :treatedBy ;
                 rdfs:domain :Food ;
                 rdfs:range :Nutrient .


###  http://www.semanticweb.org/as/ontologies/2026/6/Food_Nutrition_Graph/restrictedByReligion
:restrictedByReligion rdf:type owl:ObjectProperty ;
                      rdfs:subPropertyOf owl:topObjectProperty ;
                      rdfs:domain :Food ;
                      rdfs:range :Religion ;
                      rdfs:comment "Links a food to a religion whose followers commonly avoid it. This is a simplification: within any religion, individual practice varies (e.g. some Hindus avoid all meat, not just beef; some self-identify as vegetarian regardless of religion). Prefer asking the person directly about dietary restrictions where possible, and treat this property as a helpful default, not an absolute rule."@en .


###  http://www.semanticweb.org/as/ontologies/2026/6/Food_Nutrition_Graph/treatedBy
:treatedBy rdf:type owl:ObjectProperty ;
           rdfs:subPropertyOf owl:topObjectProperty ;
           rdfs:domain :Nutrient ;
           rdfs:range :Food ;
           rdfs:comment "Links a nutrient (deficiency) to a food that is a good source to treat it."@en .


#################################################################
#    Data properties
#################################################################

###  http://www.semanticweb.org/as/ontologies/2026/6/Food_Nutrition_Graph/hasCalcium_mg_per_100g
:hasCalcium_mg_per_100g rdf:type owl:DatatypeProperty ;
                        rdfs:subPropertyOf owl:topDataProperty ;
                        rdfs:domain :Food ;
                        rdfs:range xsd:float .


###  http://www.semanticweb.org/as/ontologies/2026/6/Food_Nutrition_Graph/hasCarbohydrate_g_per_100g
:hasCarbohydrate_g_per_100g rdf:type owl:DatatypeProperty ;
                            rdfs:subPropertyOf owl:topDataProperty ;
                            rdfs:domain :Food ;
                            rdfs:range xsd:float .


###  http://www.semanticweb.org/as/ontologies/2026/6/Food_Nutrition_Graph/hasFatContent_g_per_100g
:hasFatContent_g_per_100g rdf:type owl:DatatypeProperty ;
                          rdfs:subPropertyOf owl:topDataProperty ;
                          rdfs:domain :Food ;
                          rdfs:range xsd:float .


###  http://www.semanticweb.org/as/ontologies/2026/6/Food_Nutrition_Graph/hasIronContent_mg_per_100g
:hasIronContent_mg_per_100g rdf:type owl:DatatypeProperty ;
                            rdfs:subPropertyOf owl:topDataProperty ;
                            rdfs:domain :Food ;
                            rdfs:range xsd:float .


###  http://www.semanticweb.org/as/ontologies/2026/6/Food_Nutrition_Graph/hasNaturalUnitLabel
:hasNaturalUnitLabel rdf:type owl:DatatypeProperty ;
                     rdfs:subPropertyOf owl:topDataProperty ;
                     rdfs:domain :Food ;
                     rdfs:range xsd:string ;
                     rdfs:comment "Human-friendly countable unit for this food (e.g. 'টি (ডিম)'), used together with hasServingSize_g -- which represents the weight of ONE such unit -- to phrase quantity recommendations like '৩টি ডিম' instead of raw grams."@en .


###  http://www.semanticweb.org/as/ontologies/2026/6/Food_Nutrition_Graph/hasProteinContent_g_per_100g
:hasProteinContent_g_per_100g rdf:type owl:DatatypeProperty ;
                              rdfs:subPropertyOf owl:topDataProperty ;
                              rdfs:domain :Food ;
                              rdfs:range xsd:float .


###  http://www.semanticweb.org/as/ontologies/2026/6/Food_Nutrition_Graph/hasRDA_female_daily
:hasRDA_female_daily rdf:type owl:DatatypeProperty ;
                     rdfs:subPropertyOf owl:topDataProperty ;
                     rdfs:domain :Nutrient ;
                     rdfs:range xsd:float .


###  http://www.semanticweb.org/as/ontologies/2026/6/Food_Nutrition_Graph/hasRDA_male_daily
:hasRDA_male_daily rdf:type owl:DatatypeProperty ;
                   rdfs:subPropertyOf owl:topDataProperty ;
                   rdfs:domain :Nutrient ;
                   rdfs:range xsd:float .


###  http://www.semanticweb.org/as/ontologies/2026/6/Food_Nutrition_Graph/hasServingSize_g
:hasServingSize_g rdf:type owl:DatatypeProperty ;
                  rdfs:subPropertyOf owl:topDataProperty ;
                  rdfs:domain :Food ;
                  rdfs:range xsd:float .


###  http://www.semanticweb.org/as/ontologies/2026/6/Food_Nutrition_Graph/hasVitaminA_mcg_per_100g
:hasVitaminA_mcg_per_100g rdf:type owl:DatatypeProperty ;
                          rdfs:subPropertyOf owl:topDataProperty ;
                          rdfs:domain :Food ;
                          rdfs:range xsd:float .


###  http://www.semanticweb.org/as/ontologies/2026/6/Food_Nutrition_Graph/hasVitaminC_mg_per_100g
:hasVitaminC_mg_per_100g rdf:type owl:DatatypeProperty ;
                         rdfs:subPropertyOf owl:topDataProperty ;
                         rdfs:domain :Food ;
                         rdfs:range xsd:float .


###  http://www.semanticweb.org/as/ontologies/2026/6/Food_Nutrition_Graph/hasVitaminD_mcg_per_100g
:hasVitaminD_mcg_per_100g rdf:type owl:DatatypeProperty ;
                          rdfs:subPropertyOf owl:topDataProperty ;
                          rdfs:domain :Food ;
                          rdfs:range xsd:float .


###  http://www.semanticweb.org/as/ontologies/2026/6/Food_Nutrition_Graph/hasZincContent_mg_per_100g
:hasZincContent_mg_per_100g rdf:type owl:DatatypeProperty ;
                            rdfs:subPropertyOf owl:topDataProperty ;
                            rdfs:domain :Food ;
                            rdfs:range xsd:float .


#################################################################
#    Classes
#################################################################

###  http://www.semanticweb.org/as/ontologies/2026/6/Food_Nutrition_Graph/Beverage
:Beverage rdf:type owl:Class ;
          rdfs:subClassOf :Food ;
          rdfs:comment "Lifestyle-tracking category, excluded from WHO DDS scoring."@en .


###  http://www.semanticweb.org/as/ontologies/2026/6/Food_Nutrition_Graph/CitrusFruit
:CitrusFruit rdf:type owl:Class ;
             rdfs:subClassOf :Fruit ;
             owl:disjointWith :OtherFruit .


###  http://www.semanticweb.org/as/ontologies/2026/6/Food_Nutrition_Graph/Dairy
:Dairy rdf:type owl:Class ;
       rdfs:subClassOf :Food .


###  http://www.semanticweb.org/as/ontologies/2026/6/Food_Nutrition_Graph/Egg
:Egg rdf:type owl:Class ;
     rdfs:subClassOf :Food .


###  http://www.semanticweb.org/as/ontologies/2026/6/Food_Nutrition_Graph/Fish
:Fish rdf:type owl:Class ;
      rdfs:subClassOf :Food .


###  http://www.semanticweb.org/as/ontologies/2026/6/Food_Nutrition_Graph/Food
:Food rdf:type owl:Class .


###  http://www.semanticweb.org/as/ontologies/2026/6/Food_Nutrition_Graph/Fruit
:Fruit rdf:type owl:Class ;
       rdfs:subClassOf :Food .


###  http://www.semanticweb.org/as/ontologies/2026/6/Food_Nutrition_Graph/Grain
:Grain rdf:type owl:Class ;
       rdfs:subClassOf :Food .


###  http://www.semanticweb.org/as/ontologies/2026/6/Food_Nutrition_Graph/GreenLeafy
:GreenLeafy rdf:type owl:Class ;
            rdfs:subClassOf :Vegetable ;
            owl:disjointWith :OtherVegetable .


###  http://www.semanticweb.org/as/ontologies/2026/6/Food_Nutrition_Graph/JunkFood
:JunkFood rdf:type owl:Class ;
          rdfs:subClassOf :Food ;
          rdfs:comment "Lifestyle-tracking category, excluded from WHO DDS scoring."@en .


###  http://www.semanticweb.org/as/ontologies/2026/6/Food_Nutrition_Graph/Legume
:Legume rdf:type owl:Class ;
        rdfs:subClassOf :Food .


###  http://www.semanticweb.org/as/ontologies/2026/6/Food_Nutrition_Graph/Macronutrient
:Macronutrient rdf:type owl:Class ;
               rdfs:subClassOf :Nutrient ;
               owl:disjointWith :Micronutrient .


###  http://www.semanticweb.org/as/ontologies/2026/6/Food_Nutrition_Graph/Meat
:Meat rdf:type owl:Class ;
      rdfs:subClassOf :Food .


###  http://www.semanticweb.org/as/ontologies/2026/6/Food_Nutrition_Graph/Micronutrient
:Micronutrient rdf:type owl:Class ;
               rdfs:subClassOf :Nutrient .


###  http://www.semanticweb.org/as/ontologies/2026/6/Food_Nutrition_Graph/Nutrient
:Nutrient rdf:type owl:Class .


###  http://www.semanticweb.org/as/ontologies/2026/6/Food_Nutrition_Graph/Oil
:Oil rdf:type owl:Class ;
     rdfs:subClassOf :Food .


###  http://www.semanticweb.org/as/ontologies/2026/6/Food_Nutrition_Graph/OtherFruit
:OtherFruit rdf:type owl:Class ;
            rdfs:subClassOf :Fruit .


###  http://www.semanticweb.org/as/ontologies/2026/6/Food_Nutrition_Graph/OtherVegetable
:OtherVegetable rdf:type owl:Class ;
                rdfs:subClassOf :Vegetable .


###  http://www.semanticweb.org/as/ontologies/2026/6/Food_Nutrition_Graph/Religion
:Religion rdf:type owl:Class ;
          rdfs:comment "Used only to flag common food avoidances as a helpful default; not a claim about any individual's actual practice."@en .


###  http://www.semanticweb.org/as/ontologies/2026/6/Food_Nutrition_Graph/Symptom
:Symptom rdf:type owl:Class .


###  http://www.semanticweb.org/as/ontologies/2026/6/Food_Nutrition_Graph/Vegetable
:Vegetable rdf:type owl:Class ;
           rdfs:subClassOf :Food .


